// NSSM executable resources.
#define NSSM_COMPILE_RC
#include "nssm.h"
#include "messages.rc"
#include "resource.h"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION NSSM_VERSIONINFO
    PRODUCTVERSION NSSM_VERSIONINFO
    FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE
#ifdef _DEBUG
    FILEFLAGS NSSM_FILEFLAGS | VS_FF_DEBUG
#else
    FILEFLAGS NSSM_FILEFLAGS
#endif
    FILEOS VOS__WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments", NSSM_COMMENTS
            VALUE "CompanyName", NSSM_COMPANY
            VALUE "FileDescription", NSSM_FILE_DESCRIPTION
            VALUE "FileVersion", NSSM_VERSION
            VALUE "LegalCopyright", NSSM_COPYRIGHT
            VALUE "OriginalFileName", NSSM_ORIGINAL_FILENAME
            VALUE "ProductName", NSSM_PRODUCT_NAME
            VALUE "ProductVersion", NSSM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0, 0x0804, 0x04B0
    END
END

// Retain the executable icon for Explorer and file properties.  NSSM itself
// has no graphical user interface.
IDI_NSSM ICON "nssm.ico"

1 RT_MANIFEST "nssm.manifest"
