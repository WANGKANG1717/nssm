// SvcPilot executable resources.
#define SVP_COMPILE_RC
#include <windows.h>
#include "version.h"
#include "messages.rc"
#include "resource.h"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION SVP_VERSIONINFO
    PRODUCTVERSION SVP_VERSIONINFO
    FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE
#ifdef _DEBUG
    FILEFLAGS SVP_FILEFLAGS | VS_FF_DEBUG
#else
    FILEFLAGS SVP_FILEFLAGS
#endif
    FILEOS VOS__WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments", SVP_COMMENTS
            VALUE "CompanyName", SVP_COMPANY
            VALUE "FileDescription", SVP_FILE_DESCRIPTION
            VALUE "FileVersion", SVP_VERSION
            VALUE "LegalCopyright", SVP_COPYRIGHT
            VALUE "OriginalFileName", SVP_ORIGINAL_FILENAME
            VALUE "ProductName", SVP_PRODUCT_NAME
            VALUE "ProductVersion", SVP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0, 0x0804, 0x04B0
    END
END

// Retain the executable icon for Explorer and file properties.  SvcPilot
// has no graphical user interface.
IDI_SVP ICON "svcpilot.ico"

1 RT_MANIFEST "svcpilot.manifest"
