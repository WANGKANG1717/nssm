{
  "schema": 1,
  "service": {
    "name": "nssm-config-test",
    "displayName": "NSSM 声明式配置测试",
    "description": "验证 UTF-8 配置文件与参数数组。",
    "startup": "manual",
    "account": {
      "type": "virtual"
    }
  },
  "application": {
    "path": "C:\\Windows\\System32\\cmd.exe",
    "arguments": [
      "/d",
      "/c",
      "exit 0"
    ],
    "inheritEnvironment": true,
    "environment": {
      "NSSM_TEST_VALUE": "中文值"
    }
  },
  "recovery": {
    "mode": "onFailure",
    "initialDelayMs": 1000,
    "maximumDelayMs": 60000,
    "multiplier": 2,
    "jitterPercent": 10,
    "windowMs": 60000,
    "maximumRestarts": 5,
    "resetAfterMs": 60000
  }
}
