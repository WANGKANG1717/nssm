#pragma once

#define SVP_WIDEN_INNER(value) L##value
#define SVP_WIDEN(value) SVP_WIDEN_INNER(value)

#define SVP_VERSION L"@PROJECT_VERSION@"
#define SVP_VERSIONINFO @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#ifndef SVP_BUILD_LABEL
#define SVP_BUILD_LABEL "release"
#endif
#define SVP_DATE SVP_WIDEN(SVP_BUILD_LABEL)
#define SVP_ARCHITECTURE L"64-bit"
#ifdef _DEBUG
#define SVP_DEBUG L" debug"
#else
#define SVP_DEBUG L""
#endif
#define SVP_CONFIGURATION SVP_ARCHITECTURE SVP_DEBUG
#define SVP_FILEFLAGS 0L
#define SVP_COPYRIGHT L"Public Domain; Author fightroad"

/* Configurable metadata consumed by the VERSIONINFO resource. */
#define SVP_COMPANY L"WANGKANG1717"
#define SVP_FILE_DESCRIPTION L"SvcPilot Windows service supervisor"
#define SVP_COMMENTS L"https://github.com/WANGKANG1717/nssm"
#define SVP_ORIGINAL_FILENAME L"svp.exe"
#define SVP_PRODUCT_NAME L"SvcPilot"
