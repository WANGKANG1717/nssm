#pragma once

#define NSSM_WIDEN_INNER(value) L##value
#define NSSM_WIDEN(value) NSSM_WIDEN_INNER(value)

#define NSSM_VERSION L"@PROJECT_VERSION@"
#define NSSM_VERSIONINFO @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#ifndef NSSM_BUILD_LABEL
#define NSSM_BUILD_LABEL "release"
#endif
#define NSSM_DATE NSSM_WIDEN(NSSM_BUILD_LABEL)
#define NSSM_ARCHITECTURE L"64-bit"
#ifdef _DEBUG
#define NSSM_DEBUG L" debug"
#else
#define NSSM_DEBUG L""
#endif
#define NSSM_CONFIGURATION NSSM_ARCHITECTURE NSSM_DEBUG
#define NSSM_FILEFLAGS 0L
#define NSSM_COPYRIGHT L"Public Domain; Author fightroad"

/* Configurable metadata consumed by the VERSIONINFO resource. */
#define NSSM_COMPANY L"WANGKANG1717"
#define NSSM_FILE_DESCRIPTION L"稳定可靠的服务管理器"
#define NSSM_COMMENTS L"https://github.com/WANGKANG1717/nssm"
#define NSSM_ORIGINAL_FILENAME L"nssm.exe"
#define NSSM_PRODUCT_NAME L"NSSM"
